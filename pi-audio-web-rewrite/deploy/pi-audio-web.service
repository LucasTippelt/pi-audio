[Unit]
Description=Pi Audio Web Control Server
After=network.target pi-audio-dsp.service pi-audio-engine.service
Wants=pi-audio-dsp.service

[Service]
Type=simple
User=www-data
Group=audio
WorkingDirectory=/var/www/pi-audio/pi-audio-web-rewrite
ExecStartPre=/usr/bin/node --version
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Core environment
Environment=NODE_ENV=production
Environment=HTTP_PORT=80
Environment=WS_PATH=/ws

# Config paths
Environment=PI_AUDIO_CONFIG_DIR=/etc/pi-audio/config
Environment=PI_AUDIO_PRESETS_DIR=/etc/pi-audio/presets

# Audio card settings
Environment=PI_AUDIO_CARD=0
Environment=PI_AUDIO_CONTROL=PCM

# XRUN tracking
Environment=PI_AUDIO_XRUN_FILE=/run/pi-audio/xrun

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/www/pi-audio /etc/pi-audio /dev/shm /run/pi-audio
PrivateTmp=true

[Install]
WantedBy=multi-user.target
