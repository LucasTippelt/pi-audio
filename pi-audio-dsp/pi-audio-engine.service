[Unit]
Description=Pi Audio DSP Engine
After=sound.target pi-audio-ws-server.service
BindsTo=pi-audio-ws-server.service

[Service]
Type=simple
RuntimeDirectory=pi-audio
RuntimeDirectoryMode=0775
ExecStart=/usr/local/bin/pi-audio-engine /etc/pi-audio/config/current.json /var/log/pi-audio/engine.log
Restart=on-failure
RestartSec=3
User=pi
Group=audio

[Install]
WantedBy=multi-user.target
